<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>becky專案月曆</title>
<style>
:root{--ink:#27313d;--muted:#697584;--line:#dfe5eb;--bg:#f5f7fa;--accent:#365e8d}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"PingFang TC","Microsoft JhengHei",sans-serif;font-size:14px}
button,input,select,textarea{font:inherit}
button,.filebtn{cursor:pointer;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:9px;padding:9px 13px}
button:hover,.filebtn:hover{background:#edf2f7}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #9fbfe1;outline-offset:2px}
.primary{background:var(--accent);color:white;border-color:var(--accent)}
.primary:hover{background:#294e79}
.wrap{max-width:1700px;margin:auto;padding:24px}
header{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
h1{font-size:26px;letter-spacing:-.6px;margin:0}
.sub{color:var(--muted);margin:7px 0 0;font-size:13px}
.actions,.nav,.tools{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.panel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:18px}
.notice{background:#eef3f9;color:#3b526d;border-radius:10px;padding:12px 15px;margin-top:16px;line-height:1.7}
.filters{display:grid;grid-template-columns:1fr 1fr 1fr 1.5fr auto;gap:12px;align-items:end}
label.field{display:flex;flex-direction:column;gap:6px;font-size:12px;color:var(--muted)}
input,select,textarea{border:1px solid #ccd5df;border-radius:8px;padding:9px 10px;background:#fff;color:var(--ink);width:100%;min-width:0}
input[type=checkbox]{width:auto;accent-color:var(--accent)}
textarea{resize:vertical;min-height:85px}
.monthbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin:21px 0 12px}
.monthbar h2{font-size:23px;margin:0;min-width:155px;text-align:center}
#month{width:158px}
#summary{color:var(--muted);font-size:13px}
.legend{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}
.legend button{padding:5px 9px;font-size:12px;border-left:5px solid var(--p);background:var(--pbg)}
.legend button.active{outline:2px solid var(--p);outline-offset:1px}
.calendar-shell{overflow:auto;border-radius:12px;border:1px solid var(--line);background:white}
.weekhead,.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));min-width:850px}
.weekhead{background:#eef2f6}
.weekhead div{padding:11px;text-align:center;font-size:12px;font-weight:650;border-right:1px solid var(--line)}
.day{min-height:150px;border-top:1px solid var(--line);border-right:1px solid var(--line);padding:7px;min-width:0}
.day:nth-child(7n){border-right:0}
.day.out{background:#f8fafc}
.day.out .daynum{color:#9ca5af}
.daytop{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}
.daynum{font-weight:700;border:0;background:transparent;padding:3px 6px;border-radius:6px}
.daynum.today{background:var(--accent);color:white}
.addday{border:0;background:transparent;color:#8591a0;padding:2px 7px;font-size:18px}
.card{margin-bottom:7px;border:1px solid var(--pborder);border-left:4px solid var(--p);border-radius:8px;background:var(--pbg);padding:8px;color:#25313c;overflow-wrap:anywhere}
.card.done{opacity:.65}
.card.done .task{text-decoration:line-through}
.cardhead{display:flex;justify-content:space-between;align-items:start;gap:6px}
.project{font-size:12px;font-weight:750;color:var(--p)}
.cardopen{display:block;width:100%;text-align:left;padding:0;background:transparent;border:0;border-radius:0}
.cardopen:hover{background:transparent}
.task{font-size:13px;line-height:1.55;margin:5px 0}
.meta{font-size:11px;color:#596574;line-height:1.6}
.checkline{display:flex;align-items:center;gap:4px;font-size:11px;white-space:nowrap}
.empty{padding:38px 20px;text-align:center;color:var(--muted);line-height:1.9;background:#fff;border:1px dashed #ccd6e0;border-radius:12px;margin-top:14px}
#empty[hidden], [hidden]{display:none!important}
.list{display:grid;gap:9px}
.list .card{display:grid;grid-template-columns:105px 1fr auto;gap:14px;margin:0}
.listdate{font-weight:650;font-size:13px}
.footer{font-size:12px;color:var(--muted);line-height:1.8;margin-top:16px}
dialog{border:1px solid var(--line);border-radius:16px;padding:0;width:min(630px,calc(100% - 24px));max-height:90vh;color:var(--ink);box-shadow:0 20px 70px #23354a33}
dialog::backdrop{background:#172b4566}
.modalhead{padding:19px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.modalhead h2{font-size:19px;margin:0}
.formbody{padding:20px 22px;display:grid;grid-template-columns:1fr 1fr;gap:14px}
.full{grid-column:1/-1}
.modalfoot{padding:16px 22px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.danger{color:#a83535}
#status{white-space:pre-wrap;max-height:180px;overflow:auto;font-size:12px;line-height:1.8}
#status:empty{display:none}
#formerror{color:#a83535;white-space:pre-wrap}
#deleteask{padding:10px;background:#fff1ef;border-radius:8px;color:#8a3434}
.filebtn{display:inline-flex;align-items:center;gap:6px}
.badge{border-radius:5px;background:#ffffffa6;padding:1px 5px}
@media(max-width:800px){.filters{grid-template-columns:1fr 1fr}.filters .search{grid-column:1/-1}.wrap{padding:15px}header .actions{width:100%}h1{font-size:23px}.list .card{grid-template-columns:82px 1fr}.list .checkline{grid-column:2}.monthbar{align-items:start}}
@media(max-width:440px){.filters{grid-template-columns:1fr}.filters .search{grid-column:auto}.formbody{grid-template-columns:1fr}.full{grid-column:auto}.actions button,.filebtn{font-size:12px;padding:9px 10px}.nav{gap:4px}.monthbar h2{font-size:20px;min-width:135px}}
@media print{
@page{size:A3 landscape;margin:9mm}
body{background:#fff}.wrap{padding:0;max-width:none}
.actions,.filters,.notice,.legend,.nav button,.tools,.footer,#status,.addday,#empty{display:none!important}
.panel{padding:0;border:0;margin:0}.monthbar{margin:12px 0}header{margin-bottom:10px}
.calendar-shell{overflow:visible}.weekhead,.calendar{min-width:0}
.day{min-height:100px;break-inside:avoid}.card{break-inside:avoid;padding:5px;font-size:10px;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.task{font-size:10px}.meta,.project,.checkline{font-size:9px}.list .card{break-inside:avoid}
}
</style>
</head>
<body>
<div class="wrap">
<header>
<div><h1>becky 專案月曆</h1><p class="sub">專案各自分色 · 卡片分類 · 完成核實 · 離線使用</p></div>
<div class="actions">
<label class="filebtn">匯入 XLSX<input id="files" type="file" accept=".xlsx" multiple hidden></label>
<button class="primary" id="add">＋ 新增卡片</button>
<button id="save">下載含資料 HTML</button>
<button id="export">匯出卡片 CSV</button>
<button id="print">列印</button>
</div>
</header>
<div id="intro" class="notice">先匯入《卡片總表.xlsx》載入完整卡片。可多選檔案、分次追加；所有資料只在本頁處理，不會上傳。修改後請下載含資料 HTML 保存，重新整理不會自動保存。</div>
<div class="panel">
<div class="filters">
<label class="field">專案<select id="projectFilter"><option value="">全部專案</option></select></label>
<label class="field">卡片類型<select id="typeFilter"><option value="">全部類型</option></select></label>
<label class="field">完成核實<select id="doneFilter"><option value="">全部狀態</option><option value="no">尚未核實</option><option value="yes">已完成核實</option></select></label>
<label class="field search">搜尋卡片<input id="search" placeholder="專案、任務、編號、說明…" type="search"></label>
<button id="reset">清除篩選</button>
</div>
<div class="legend" id="legend" aria-label="專案配色與快速篩選"></div>
</div>
<div id="status" class="notice" role="status" aria-live="polite"></div>
<div class="monthbar">
<div class="nav">
<button id="prev" aria-label="上個月">‹</button>
<h2 id="monthTitle"></h2>
<button id="next" aria-label="下個月">›</button>
<input id="month" type="month" aria-label="選擇月份">
<button id="today">本月</button>
</div>
<div class="tools">
<span id="summary"></span>
<select id="view" aria-label="檢視模式"><option value="calendar">月曆檢視</option><option value="list">當月清單</option></select>
</div>
</div>
<div class="calendar-shell" id="calendarShell">
<div class="weekhead"><div>星期一</div><div>星期二</div><div>星期三</div><div>星期四</div><div>星期五</div><div>星期六</div><div>星期日</div></div>
<div class="calendar" id="calendar"></div>
</div>
<div id="list" class="list" hidden></div>
<div id="empty" class="empty" hidden></div>
<p class="footer">點卡片可查看／編輯完整欄位，點日期旁的「＋」可新增當日卡片。匯入以檔案原日期、原分類為準，不重排排程，也不刪除內容相似的卡片。同一檔案重複匯入會再追加，請留意匯入訊息。列印使用目前月份與篩選條件，建議 A3 橫向。</p>
</div>

<dialog id="editor">
<form id="cardForm">
<div class="modalhead"><h2 id="editorTitle">新增卡片</h2><button type="button" id="closeEditor" aria-label="關閉">✕</button></div>
<div class="formbody">
<label class="field">專案<input id="fProject" list="projectOptions" required placeholder="選取或輸入新專案"><datalist id="projectOptions"></datalist></label>
<label class="field">卡片類型<input id="fType" list="typeOptions" required placeholder="選取或輸入新類型"><datalist id="typeOptions"></datalist></label>
<label class="field full">項目／任務<input id="fTask" list="taskOptions" required placeholder="選取既有項目，或輸入新項目"><datalist id="taskOptions"></datalist></label>
<label class="field">日期<input id="fDate" type="date" required></label>
<label class="field">時間<input id="fTime" placeholder="例如：15:00–16:00"></label>
<label class="field">卡片編號<input id="fId" placeholder="留白將自動產生手動卡片編號"></label>
<label class="field">CUE表編號<input id="fCue"></label>
<label class="field full">階段<input id="fStage"></label>
<label class="field full">說明<textarea id="fNote"></textarea></label>
<label class="field full">本次異動<input id="fChange"></label>
<label class="checkline full"><input id="fDone" type="checkbox">完成核實</label>
<div id="formerror" class="full" role="status"></div>
<div class="full" id="deleteask" hidden>確定刪除這張卡片？此動作不影響原始 Excel。
<div class="actions" style="margin-top:8px"><button type="button" id="deleteYes" class="danger">確定刪除</button><button type="button" id="deleteNo">取消</button></div>
</div>
</div>
<div class="modalfoot">
<button type="button" class="danger" id="delete">刪除卡片</button>
<div class="actions"><button type="button" id="cancel">取消</button><button type="submit" class="primary">儲存卡片</button></div>
</div>
</form>
</dialog>

<script type="application/json" id="savedData">{"cards":[],"imports":[],"month":""}</script>
<script>
"use strict";
const BASE_PROJECTS=["Threads情報創作者經營","nac1","nac2","大井","大成","宇勝","宇足","安寶","寶貝可愛（未分碼）","展晟照明","廣和","拓霖","晶采","法兒貝","美無痕","美藍雷","設計先生","黃裳元吉"];
const BASE_TYPES=["其他事項","客回","客審","文案上線","會議","檢查","派案寫手","熱門文章客回／截止確認上線","熱門文章搜尋"];
const PALETTE=["#3366CC","#DD3366","#25846B","#946200","#777720","#8B4DB0","#34798C","#B85A2A","#00799E","#666666","#A34CA3","#666600","#B45A00","#238548","#B12C58","#4778A8","#927023","#663399"];
const FIELDS=["卡片編號","日期","星期","專案","分類","任務","CUE表編號","時間","階段","說明","本次異動","完成核實"];
const $=id=>document.getElementById(id);
const pad=n=>String(n).padStart(2,"0");
const dateKey=d=>d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());
const monthKey=d=>dateKey(d).slice(0,7);
const TODAY=dateKey(new Date());
const WEEK=["日","一","二","三","四","五","六"];
const DATA=JSON.parse($("savedData").textContent);
let cards=Array.isArray(DATA.cards)?DATA.cards:[];
let imports=Array.isArray(DATA.imports)?DATA.imports:[];
let currentMonth=monthKey(new Date());
let editKey=null,dirty=false,busy=false;
function uid(){return globalThis.crypto&&crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+"-"+Math.random().toString(36).slice(2)}
cards.forEach(c=>{if(!c.key)c.key=uid()});
function el(tag,cls,text){const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n}
function uniques(v){return [...new Set(v.filter(Boolean))].sort((a,b)=>a.localeCompare(b,"zh-Hant"))}
function projects(){return uniques([...BASE_PROJECTS,...cards.map(c=>c.project)])}
function types(){return uniques([...BASE_TYPES,...cards.map(c=>c.type)])}
function color(p){let i=BASE_PROJECTS.indexOf(p);if(i>=0)return PALETTE[i];let h=0;for(const x of p)h=(h*31+x.charCodeAt(0))>>>0;return "hsl("+(h%360)+" 43% 36%)"}
function paint(node,p){const c=color(p);node.style.setProperty("--p",c);node.style.setProperty("--pbg","color-mix(in srgb, "+c+" 9%, white)");node.style.setProperty("--pborder","color-mix(in srgb, "+c+" 27%, white)")}
function options(id,values,first){const s=$(id),old=s.value;s.replaceChildren();if(first!==undefined){const o=el("option","",first);o.value="";s.append(o)}for(const v of values){const o=el("option","",v);o.value=v;s.append(o)}if(values.includes(old))s.value=old}
function refreshOptions(){
 options("projectFilter",projects(),"全部專案");options("typeFilter",types(),"全部類型");
 options("projectOptions",projects());options("typeOptions",types());taskOptions();
}
function taskOptions(){const p=$("fProject").value.trim();options("taskOptions",uniques(cards.filter(c=>!p||c.project===p).map(c=>c.task)))}
function setDirty(){dirty=true;$("save").textContent="下載含資料 HTML ●"}
function matches(c){
 const p=$("projectFilter").value,t=$("typeFilter").value,d=$("doneFilter").value,q=$("search").value.trim().toLocaleLowerCase();
 return (!p||c.project===p)&&(!t||c.type===t)&&(!d||(d==="yes")===!!c.done)&&(!q||[c.id,c.project,c.type,c.task,c.note,c.stage,c.cue,c.time].join(" ").toLocaleLowerCase().includes(q));
}
function sorted(a){return a.sort((x,y)=>x.date.localeCompare(y.date)||(x.time||"").localeCompare(y.time||"",undefined,{numeric:true})||(x.id||"").localeCompare(y.id||"",undefined,{numeric:true}))}
function cardNode(c,list=false){
 const box=el("article","card"+(c.done?" done":""));paint(box,c.project);
 const open=el("button","cardopen");open.type="button";open.title="查看及編輯卡片";open.onclick=()=>openEditor(c.key);
 const heading=el("div","project",c.project);open.append(heading,el("div","task",c.task));
 const m=[c.type,c.time,c.stage].filter(Boolean).join(" · ");
 open.append(el("div","meta",m),el("div","meta",c.id||"未填編號"));
 const check=el("label","checkline");const cb=el("input");cb.type="checkbox";cb.checked=!!c.done;cb.onchange=()=>{c.done=cb.checked;setDirty();render()};
 check.append(cb,document.createTextNode("完成核實"));
 if(list){box.append(el("div","listdate",c.date.replaceAll("-","/")),open,check)}
 else{const top=el("div","cardhead");top.append(el("span","badge",c.type),check);box.append(top,open)}
 return box;
}
function render(){
 $("month").value=currentMonth;const [y,m]=currentMonth.split("-").map(Number);
 $("monthTitle").textContent=y+" 年 "+m+" 月";
 const visible=sorted(cards.filter(matches)),inMonth=visible.filter(c=>c.date.startsWith(currentMonth));
 const completed=inMonth.filter(c=>c.done).length;
 $("summary").textContent="當月 "+inMonth.length.toLocaleString()+" 張 · 已核實 "+completed.toLocaleString()+" 張 · 總資料 "+cards.length.toLocaleString()+" 張";
 const legend=$("legend");legend.replaceChildren();
 for(const p of projects()){const b=el("button",$("projectFilter").value===p?"active":"",p);paint(b,p);b.onclick=()=>{$("projectFilter").value=$("projectFilter").value===p?"":p;render()};legend.append(b)}
 const calendar=$("calendar");calendar.replaceChildren();
 const first=new Date(y,m-1,1),start=new Date(y,m-1,1-((first.getDay()+6)%7));
 const days=new Date(y,m,0).getDate(),cells=Math.ceil((((first.getDay()+6)%7)+days)/7)*7;
 const byDay=new Map();for(const c of visible){if(!byDay.has(c.date))byDay.set(c.date,[]);byDay.get(c.date).push(c)}
 for(let i=0;i<cells;i++){
  const d=new Date(start.getFullYear(),start.getMonth(),start.getDate()+i),k=dateKey(d),out=d.getMonth()!==m-1;
  const cell=el("div","day"+(out?" out":""));const top=el("div","daytop");
  const num=el("button","daynum"+(k===TODAY?" today":""),out?(d.getMonth()+1)+"/"+d.getDate():String(d.getDate()));
  num.title="新增 "+k+" 卡片";num.onclick=()=>openEditor(null,k);
  const plus=el("button","addday","＋");plus.title="新增 "+k+" 卡片";plus.onclick=()=>openEditor(null,k);
  top.append(num,plus);cell.append(top);for(const c of byDay.get(k)||[])cell.append(cardNode(c));calendar.append(cell);
 }
 $("list").replaceChildren(...inMonth.map(c=>cardNode(c,true)));
 const isList=$("view").value==="list";$("list").hidden=!isList;$("calendarShell").hidden=isList;
 $("empty").hidden=inMonth.length>0;
 $("empty").textContent=cards.length?"這個月份沒有符合篩選條件的卡片。可切換月份、清除篩選，或新增卡片。":"尚未載入卡片。請按「匯入 XLSX」選擇卡片總表，或按「新增卡片」手動建立。";
 $("intro").textContent=cards.length?"資料已載入。專案顏色跨月份保持一致；nac1、nac2 分開顯示。新增、核實或修改後，請下載含資料 HTML 保存。":"先匯入《卡片總表.xlsx》載入完整卡片。可多選檔案、分次追加；所有資料只在本頁處理，不會上傳。修改後請下載含資料 HTML 保存，重新整理不會自動保存。";
}
function openEditor(key=null,date=null){
 editKey=key;const c=key?cards.find(x=>x.key===key):null;
 $("cardForm").reset();$("formerror").textContent="";$("deleteask").hidden=true;
 $("editorTitle").textContent=c?"編輯卡片":"新增卡片";$("delete").hidden=!c;
 const vals={fProject:c?.project||$("projectFilter").value,fType:c?.type||$("typeFilter").value||"其他事項",fTask:c?.task||"",fDate:c?.date||date||(TODAY.startsWith(currentMonth)?TODAY:currentMonth+"-01"),fTime:c?.time||"",fId:c?.id||"",fCue:c?.cue||"",fStage:c?.stage||"",fNote:c?.note||"",fChange:c?.change||"手動新增"};
 for(const [id,v] of Object.entries(vals))$(id).value=v;
 $("fDone").checked=!!c?.done;taskOptions();$("editor").showModal();
}
$("cardForm").onsubmit=e=>{
 e.preventDefault();const project=$("fProject").value.trim(),type=$("fType").value.trim(),task=$("fTask").value.trim(),date=$("fDate").value;
 if(!project||!type||!task||!validDate(date)){$("formerror").textContent="請填寫專案、類型、項目及有效日期。";return}
 const old=editKey?cards.find(c=>c.key===editKey):null;
 let id=$("fId").value.trim();
 if(!id){let n=1;while(cards.some(c=>c.id==="M"+String(n).padStart(4,"0")))n++;id="M"+String(n).padStart(4,"0")}
 const obj={...(old||{}),key:editKey||uid(),id,date,project,type,task,time:$("fTime").value.trim(),cue:$("fCue").value.trim(),stage:$("fStage").value.trim(),note:$("fNote").value,change:$("fChange").value.trim(),done:$("fDone").checked};
 if(old)cards[cards.findIndex(c=>c.key===editKey)]=obj;else cards.push(obj);
 currentMonth=date.slice(0,7);setDirty();refreshOptions();render();$("editor").close();
 $("status").textContent="已"+(old?"更新":"新增")+"卡片："+id+"。請下載含資料 HTML 保存。";
};
for(const id of ["closeEditor","cancel"])$(id).onclick=()=>$("editor").close();
$("fProject").oninput=taskOptions;
$("delete").onclick=()=>{$("deleteask").hidden=false};
$("deleteNo").onclick=()=>{$("deleteask").hidden=true};
$("deleteYes").onclick=()=>{cards=cards.filter(c=>c.key!==editKey);setDirty();refreshOptions();render();$("editor").close();$("status").textContent="卡片已刪除。請下載含資料 HTML 保存。"};
$("add").onclick=()=>openEditor();
