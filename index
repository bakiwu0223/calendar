/* 不使用外部套件：讀取 XLSX ZIP、共用字串、工作表及 Excel 日期。 */
function validDate(s){if(!/^\d{4}-\d{2}-\d{2}$/.test(s))return false;const d=new Date(s+"T12:00:00");return !isNaN(d)&&dateKey(d)===s}
function normalDate(v,date1904=false){
 const s=String(v??"").trim();if(!s)return "";
 if(/^\d+(\.\d+)?$/.test(s)){
  const n=Number(s);if(n>0&&n<1000000){const d=new Date(Date.UTC(date1904?1904:1899,date1904?0:11,date1904?1:30)+Math.floor(n)*86400000);const k=d.toISOString().slice(0,10);return validDate(k)?k:""}
 }
 const m=s.match(/^(\d{4})[\/-](\d{1,2})[\/-](\d{1,2})(?:[T\s].*)?$/);
 if(m){const k=m[1]+"-"+pad(m[2])+"-"+pad(m[3]);return validDate(k)?k:""}
 return "";
}
function xml(text){
 const doc=new DOMParser().parseFromString(text,"application/xml");
 if(doc.getElementsByTagName("parsererror").length)throw Error("檔案 XML 內容無法解析");
 return doc;
}
function elements(node,name){return Array.from(node.getElementsByTagNameNS("*",name))}
function textRuns(node){return elements(node,"t").map(n=>n.textContent).join("")}
function resolvePath(base,target){
 if(target.startsWith("/"))return target.slice(1);
 const arr=(base.slice(0,base.lastIndexOf("/")+1)+target).split("/"),out=[];
 for(const part of arr){if(part==="..")out.pop();else if(part&&part!==".")out.push(part)}
 return out.join("/");
}
async function unzip(file){
 const buf=await file.arrayBuffer(),b=new Uint8Array(buf),v=new DataView(buf);
 let end=-1;
 for(let i=b.length-22;i>=Math.max(0,b.length-65557);i--)if(v.getUint32(i,true)===0x06054b50){end=i;break}
 if(end<0)throw Error("不是有效 XLSX，或檔案已加密；請另存為未加密 .xlsx");
 const count=v.getUint16(end+10,true),offset=v.getUint32(end+16,true);
 if(offset===0xffffffff||count===0xffff)throw Error("此頁不支援 ZIP64 格式的超大型活頁簿");
 const entries=new Map(),decoder=new TextDecoder("utf-8");let p=offset;
 for(let i=0;i<count;i++){
  if(p+46>b.length||v.getUint32(p,true)!==0x02014b50)throw Error("XLSX 壓縮目錄損壞");
  const flags=v.getUint16(p+8,true),method=v.getUint16(p+10,true),size=v.getUint32(p+20,true),raw=v.getUint32(p+24,true),nl=v.getUint16(p+28,true),ex=v.getUint16(p+30,true),co=v.getUint16(p+32,true),local=v.getUint32(p+42,true);
  const name=decoder.decode(b.slice(p+46,p+46+nl));
  entries.set(name,{flags,method,size,raw,local});p+=46+nl+ex+co;
 }
 const cache=new Map();
 async function read(name){
  if(cache.has(name))return cache.get(name);
  const e=entries.get(name);if(!e)return null;
  if(e.flags&1)throw Error("檔案已加密，請使用未加密 XLSX");
  if(e.raw>100*1024*1024)throw Error("單一工作表過大，請拆成較小檔案");
  const at=e.local;if(at+30>b.length||v.getUint32(at,true)!==0x04034b50)throw Error("壓縮檔內容損壞");
  const start=at+30+v.getUint16(at+26,true)+v.getUint16(at+28,true),compressed=b.slice(start,start+e.size);
  let bytes;
  if(e.method===0)bytes=compressed;
  else if(e.method===8){
   let stream;
   try{stream=new DecompressionStream("deflate-raw")}catch{throw Error("瀏覽器不支援本機 XLSX 解壓縮，請改用新版 Chrome 或 Edge")}
   bytes=new Uint8Array(await new Response(new Blob([compressed]).stream().pipeThrough(stream)).arrayBuffer());
  }else throw Error("不支援此 XLSX 壓縮方式");
  const text=decoder.decode(bytes);cache.set(name,text);return text;
 }
 return {read,entries};
}
function colIndex(ref){let n=0;for(const c of ref.replace(/[0-9]/g,""))n=n*26+c.charCodeAt(0)-64;return n-1}
function worksheetRows(doc,shared){
 const data=elements(doc,"sheetData")[0];if(!data)return [];
 return elements(data,"row").map(row=>{
  const a=[];let next=0;
  for(const c of elements(row,"c")){
   const ref=c.getAttribute("r"),i=ref?colIndex(ref):next;next=i+1;
   const type=c.getAttribute("t"),val=elements(c,"v")[0]?.textContent??"";
   a[i]=type==="s"?(shared[Number(val)]??""):type==="inlineStr"?textRuns(c):val;
  }return {values:a,row:row.getAttribute("r")||""};
 });
}
const trimHeader=s=>String(s??"").replace(/^\ufeff/,"").replace(/\s/g,"");
async function readCards(file){
 const z=await unzip(file);
 const wbText=await z.read("xl/workbook.xml"),relText=await z.read("xl/_rels/workbook.xml.rels");
 if(!wbText||!relText)throw Error("找不到 Excel 活頁簿結構，請另存為 .xlsx");
 const wb=xml(wbText),rels=xml(relText),relMap=new Map();
 for(const r of elements(rels,"Relationship"))if(r.getAttribute("TargetMode")!=="External")relMap.set(r.getAttribute("Id"),resolvePath("xl/workbook.xml",r.getAttribute("Target")));
 const sheets=elements(wb,"sheet").map(s=>({name:s.getAttribute("name"),path:relMap.get(s.getAttributeNS("http://schemas.openxmlformats.org/officeDocument/2006/relationships","id")||s.getAttribute("r:id"))})).filter(s=>s.path);
 const date1904=["1","true"].includes(elements(wb,"workbookPr")[0]?.getAttribute("date1904"));
 const sharedText=await z.read("xl/sharedStrings.xml");
 const shared=sharedText?elements(xml(sharedText),"si").map(textRuns):[];
 const preferred=sheets.find(s=>s.name==="卡片總表")||sheets.find(s=>s.name==="月曆保留卡片");
 const candidates=preferred?[preferred]:sheets;
 const output=[],used=[],errors=[];
 for(const s of candidates){
  const content=await z.read(s.path);if(!content)continue;
  const rows=worksheetRows(xml(content),shared);
  const headerIndex=rows.findIndex((r,i)=>i<30&&["日期","專案"].every(k=>r.values.map(trimHeader).includes(k))&&r.values.map(trimHeader).some(k=>["任務","任務名稱","項目"].includes(k)));
  if(headerIndex<0)continue;
  const headers=rows[headerIndex].values.map(trimHeader);
  function get(row,names){for(const name of names){const i=headers.indexOf(name);if(i>=0)return String(row[i]??"").trim()}return ""}
  let count=0;
  for(const record of rows.slice(headerIndex+1)){
   const r=record.values;
   if(!r.some(x=>String(x??"").trim()))continue;
   const id=get(r,["卡片編號"]),rawDate=get(r,["日期"]),project=get(r,["專案"]),task=get(r,["任務","任務名稱","項目"]);
   if(!id&&!rawDate&&!project&&!task)continue;
   const date=normalDate(rawDate,date1904);
   if(!date||!project||!task){errors.push(s.name+" 第 "+record.row+" 列："+(!date?"日期無效或缺漏；請使用完整年月日":!project?"缺少專案":"缺少任務／項目"));continue}
   const doneValue=get(r,["完成核實"]);
   output.push({key:uid(),id,date,project,type:get(r,["分類","卡片類型","類型"])||"未分類",task,cue:get(r,["CUE表編號"]),time:get(r,["時間"]),stage:get(r,["階段"]),note:get(r,["說明"]),change:get(r,["本次異動"]),done:/^(true|1|是|已完成|已核實|完成|已完成核實|✓|☑)$/i.test(doneValue),source:file.name,sheet:s.name});
   count++;
  }
  used.push(s.name+"："+count.toLocaleString()+" 張");
 }
 if(errors.length)throw Error("此檔未匯入，避免漏卡。請修正後重試：\n"+errors.slice(0,12).join("\n")+(errors.length>12?"\n另有其他欄位異常，請檢查原檔。":""));
 if(!used.length)throw Error("找不到卡片明細表。需包含「日期、專案、任務（或項目）」欄位；分類可使用「分類」或「卡片類型」");
 if(!output.length)throw Error("明細表內沒有可匯入的卡片");
 return {cards:output,sheets:used};
}
$("files").onchange=async e=>{
 const files=Array.from(e.target.files||[]);if(!files.length||busy)return;
 busy=true;$("files").disabled=true;
 const logs=[];let firstNew=null,total=0;
 try{
  for(const file of files){
   $("status").textContent=[...logs,"正在讀取："+file.name].join("\n");
   try{
    if(!/\.xlsx$/i.test(file.name))throw Error("請使用 .xlsx 檔案，不支援舊版 .xls");
    const result=await readCards(file);
    const repeated=imports.some(x=>x.name===file.name);
    cards.push(...result.cards);total+=result.cards.length;
    if(!firstNew)firstNew=sorted([...result.cards])[0].date;
    imports.push({name:file.name,date:new Date().toISOString(),count:result.cards.length});
    logs.push("✓ "+file.name+"：新增 "+result.cards.length.toLocaleString()+" 張（"+result.sheets.join("、")+"）"+(repeated?"；此檔名曾匯入，本次仍追加，請確認是否重複":""));
   }catch(err){logs.push("未匯入 "+file.name+"："+err.message)}
  }
  if(total){
   setDirty();refreshOptions();
   if(firstNew)currentMonth=firstNew.slice(0,7);
   logs.push("本次新增 "+total.toLocaleString()+" 張。原有卡片全部保留；請下載含資料 HTML 保存。");
  }
  render();$("status").textContent=logs.join("\n");
 }finally{busy=false;$("files").disabled=false;$("files").value=""}
};
refreshOptions();render();
